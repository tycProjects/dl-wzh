<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1500FFCC"/>
            <stroke android:width="1dp" android:color="#00FFCC"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0A00FFCC"/>
            <stroke android:width="1dp" android:color="#5500FFCC"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
