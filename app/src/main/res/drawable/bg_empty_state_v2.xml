<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_card" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#148B5CF6"
                android:centerColor="#0CEC4899"
                android:endColor="#0006B6D4" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
