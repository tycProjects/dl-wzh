<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backgrounds (photo or video)"
                android:textColor="@color/blue_700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Video lock screen"
                android:textColor="@color/blue_700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Play video on my lock screen" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Needs &quot;Display over other apps&quot;. When the screen turns on, the video screen opens above the lock screen. Swipe up to unlock (your PIN or fingerprint still works)."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOverlay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow display over other apps" />

            <Button
                android:id="@+id/btnAppInfo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open app settings (battery, auto-launch)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Status bar &amp; battery"
                android:textColor="@color/blue_700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Time, signal, Wi-Fi, speed, notifications and a battery that turns green while charging."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnStatusStyle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status bar &amp; battery style" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Phone app"
                android:textColor="@color/blue_700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Make this the default phone app so incoming calls use your video call screen."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDefaultPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set as default phone app" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Answer / reject button style"
                android:textColor="@color/blue_700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbGradient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Glossy gradient" />

                <RadioButton
                    android:id="@+id/rbGlass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Glass outline" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
