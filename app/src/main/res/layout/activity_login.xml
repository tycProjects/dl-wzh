<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_darker">

    
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="#1AFF2D55"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"/>

    
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:background="#0A0A84FF"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-50dp"/>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp">

        
        <ImageView
            android:id="@+id/login_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="12dp"/>

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KILLCHEAT"
            android:textColor="@color/accent_red"
            android:textSize="28sp"
            android:fontFamily="@font/orbitron"
            android:textStyle="bold"
            android:letterSpacing="0.25"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FREE FIRE UTILITY"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:fontFamily="@font/orbitron"
            android:letterSpacing="0.3"
            android:layout_marginBottom="8dp"/>

        
        <TextView
            android:id="@+id/tv_version_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textColor="@color/accent_cyan"
            android:textSize="9sp"
            android:fontFamily="@font/orbitron"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_badge_cyan"
            android:layout_marginBottom="36dp"/>

        
        <LinearLayout
            android:id="@+id/ll_notification_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_notification_banner"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                android:fontFamily="@font/orbitron"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_notif_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/ll_update_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_update_banner"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPDATE AVAILABLE"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:fontFamily="@font/orbitron"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_update_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_update_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPDATE"
                android:textColor="@color/bg_darker"
                android:textSize="10sp"
                android:fontFamily="@font/orbitron"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_cyan"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_login_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENTER LICENSE KEY"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.2"
                android:layout_marginBottom="10dp"/>

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/et_key"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="KILL-XXXX-XXXX-XXXX"
                    android:hintTextColor="#55FFFFFF"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/orbitron"
                    android:inputType="text"
                    android:maxLines="1"
                    android:background="@null"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"/>

            </LinearLayout>

            
            <TextView
                android:id="@+id/tv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF4D4D"
                android:textSize="10sp"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

        </LinearLayout>

        
        <TextView
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="LOGIN"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/orbitron"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:gravity="center"
            android:background="@drawable/bg_inject_btn"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"/>

        
        <TextView
            android:id="@+id/btn_getkey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="GET KEY"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:fontFamily="@font/orbitron"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:gravity="center"
            android:background="@drawable/bg_btn_outline_cyan"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    
    <FrameLayout
        android:id="@+id/fl_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_red"/>
    </FrameLayout>

</RelativeLayout>
