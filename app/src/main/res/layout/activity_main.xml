<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zew_bg"
    android:fitsSystemWindows="true">

    
    <LinearLayout
        android:id="@+id/main_status_strip"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/zew_bg_surface">

        <View
            android:id="@+id/main_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot"
            android:backgroundTint="@color/zew_yellow" />

        <TextView
            android:id="@+id/main_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHƯA SẴN SÀNG"
            android:textColor="@color/zew_text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZEWMOD ENGINE"
            android:textColor="@color/zew_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

    </LinearLayout>

    
    <FrameLayout
        android:id="@+id/main_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@id/main_status_strip"
        app:layout_anchorGravity="bottom"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="80dp" />

    
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/ZewMod.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

    
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_launch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="80dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_play"
        app:backgroundTint="@color/zew_accent"
        app:tint="@color/zew_text_primary"
        app:elevation="8dp"
        android:contentDescription="Khởi chạy" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
