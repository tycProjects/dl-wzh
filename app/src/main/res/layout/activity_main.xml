<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/bg" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="24dp" android:paddingBottom="28dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
    <TextView android:text="CAM STREAM" android:textColor="@color/text" android:textStyle="bold" android:textSize="25sp" android:letterSpacing="0.025" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="MOBILE  /  GAME CAPTURE" android:textColor="@color/cyan" android:textSize="10sp" android:letterSpacing="0.18" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </LinearLayout>
   <Button android:id="@+id/settings" android:text="⚙" android:textSize="21sp" android:textColor="@color/text" android:background="@drawable/bg_button" android:stateListAnimator="@null" android:minWidth="0dp" android:layout_width="52dp" android:layout_height="52dp"/>
  </LinearLayout>
  <LinearLayout android:gravity="center_vertical" android:layout_marginTop="26dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="CAPTURE CONSOLE" android:textColor="@color/muted" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.13" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/status" android:text="● READY" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:paddingStart="13dp" android:paddingEnd="13dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/bg_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_panel" android:paddingTop="18dp" android:paddingBottom="20dp" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <FrameLayout android:layout_width="220dp" android:layout_height="220dp">
    <View android:layout_gravity="center" android:background="@drawable/bg_record" android:layout_width="204dp" android:layout_height="204dp"/>
    <Button android:id="@+id/record" android:text="●" android:textSize="48sp" android:textColor="@color/text" android:background="@drawable/bg_record_core" android:stateListAnimator="@null" android:minWidth="0dp" android:padding="0dp" android:layout_gravity="center" android:layout_width="126dp" android:layout_height="126dp"/>
   </FrameLayout>
   <TextView android:id="@+id/timer" android:text="00:00:00" android:textColor="@color/text" android:textSize="34sp" android:textStyle="bold" android:fontFamily="monospace" android:gravity="center" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <TextView android:text="Tap the core to begin capture" android:textColor="@color/muted" android:textSize="13sp" android:gravity="center" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/config" android:text="Auto  •  30 FPS  •  High quality" android:textColor="@color/cyan" android:textSize="12sp" android:gravity="center" android:layout_marginTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:gravity="center_vertical" android:layout_marginTop="25dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="YOUR STUDIO" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <TextView android:text="TOOLS &amp; LIBRARY" android:textColor="@color/muted" android:textSize="10sp" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/library" android:text="▣   VIDEO LIBRARY" android:textColor="@color/text" android:textSize="12sp" android:background="@drawable/bg_button" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:layout_height="62dp"/>
   <Button android:id="@+id/camera" android:text="◉   FACE CAMERA" android:textColor="@color/text" android:textSize="12sp" android:background="@drawable/bg_button" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_height="62dp"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/floating" android:text="☷   FLOATING CONTROLS" android:textColor="@color/text" android:textSize="11sp" android:background="@drawable/bg_button" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:layout_height="62dp"/>
   <Button android:id="@+id/about" android:text="ⓘ   ABOUT CAM STREAM" android:textColor="@color/text" android:textSize="11sp" android:background="@drawable/bg_button" android:stateListAnimator="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_height="62dp"/>
  </LinearLayout>
  <TextView android:text="Native Android screen capture • Your recordings stay on this device" android:textColor="@color/muted" android:textSize="11sp" android:gravity="center" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
</ScrollView>
