<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:background="@color/bg" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="vertical" android:padding="22dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
    <TextView android:text="CAM STREAM" android:textColor="@color/text" android:textStyle="bold" android:textSize="23sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="MOBILE  •  GAME CAPTURE" android:textColor="@color/cyan" android:textSize="11sp" android:letterSpacing=".15" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </LinearLayout>
   <Button android:id="@+id/settings" android:text="⚙" android:textSize="20sp" android:backgroundTint="@color/surface2" android:layout_width="52dp" android:layout_height="52dp"/>
  </LinearLayout>
  <TextView android:id="@+id/status" android:text="● READY TO CAPTURE" android:textColor="@color/cyan" android:textStyle="bold" android:layout_marginTop="34dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <FrameLayout android:layout_gravity="center" android:layout_marginTop="20dp" android:layout_width="230dp" android:layout_height="230dp">
   <View android:layout_gravity="center" android:background="@drawable/bg_record" android:layout_width="180dp" android:layout_height="180dp"/>
   <Button android:id="@+id/record" android:text="●" android:textSize="54sp" android:textColor="@color/text" android:backgroundTint="@android:color/transparent" android:layout_gravity="center" android:layout_width="150dp" android:layout_height="150dp"/>
  </FrameLayout>
  <TextView android:id="@+id/timer" android:text="00:00:00" android:textColor="@color/text" android:textSize="28sp" android:fontFamily="monospace" android:gravity="center" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/config" android:text="Auto resolution  •  30 FPS  •  High quality" android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="YOUR STUDIO" android:textColor="@color/muted" android:textStyle="bold" android:layout_marginTop="34dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <GridLayout android:columnCount="2" android:useDefaultMargins="true" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/library" android:text="▣  Video Library" android:backgroundTint="@color/surface2" android:layout_width="150dp" android:layout_height="64dp"/>
   <Button android:id="@+id/camera" android:text="◉  Face Camera" android:backgroundTint="@color/surface2" android:layout_width="150dp" android:layout_height="64dp"/>
   <Button android:id="@+id/floating" android:text="☷  Floating Controls" android:backgroundTint="@color/surface2" android:layout_width="150dp" android:layout_height="64dp"/>
   <Button android:id="@+id/about" android:text="ⓘ  About" android:backgroundTint="@color/surface2" android:layout_width="150dp" android:layout_height="64dp"/>
  </GridLayout>
  <TextView android:text="Record gameplay with Android's secure screen-capture permission." android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
</ScrollView>
