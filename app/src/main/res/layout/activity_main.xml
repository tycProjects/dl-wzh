<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101116"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RYUZEN TAS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="GTX OVERDRIVE"
            android:textColor="#FF5967"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shizukuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#242630"
            android:padding="14dp"
            android:text="SHIZUKU: CHECKING"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/connectShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CHECK / REQUEST SHIZUKU ACCESS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="LIVE DEVICE STATUS"
            android:textColor="#FF5967"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ramStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="RAM: --"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/thermalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="THERMAL: --"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/cpuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="CPU: --"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PERFORMANCE PROFILE"
            android:textColor="#FF5967"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/profileGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/profileBalanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Balanced"
                android:textColor="#FFFFFF" />
            <RadioButton
                android:id="@+id/profileGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Game focus (safe)"
                android:textColor="#FFFFFF" />
            <RadioButton
                android:id="@+id/profileSaver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Battery saver"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <Button
            android:id="@+id/applyProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APPLY PROFILE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TOOLS"
            android:textColor="#FF5967"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refreshStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REFRESH DEVICE STATS" />

        <Button
            android:id="@+id/openShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OPEN SHIZUKU APP" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Floating overlay is available while this dashboard is open. A persistent overlay requires Android's special overlay permission and is not enabled by default."
            android:textColor="#B8BAC4"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/logStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#242630"
            android:padding="12dp"
            android:text="GTX CONFIG: Ready."
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
