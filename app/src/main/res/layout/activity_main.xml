<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <ImageButton
            android:id="@+id/btnHome"
            style="@style/IconBtn"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <LinearLayout
            android:id="@+id/urlPill"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/urlIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Site"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:hint="Search or type URL"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMic"
            style="@style/IconBtn"
            android:contentDescription="Voice search"
            android:src="@drawable/ic_mic" />

        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tabs"
            android:focusable="true">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/IconBtn"
            android:contentDescription="Menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <com.nomango.browser.LoadBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:alpha="0"
        android:elevation="6dp" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/suggestPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/suggestList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/tabsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp">

                    <ImageButton
                        android:id="@+id/btnNewInc"
                        style="@style/IconBtn"
                        android:contentDescription="New incognito tab"
                        android:src="@drawable/ic_mask" />

                    <TextView
                        android:id="@+id/tabsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnTabsMenu"
                        style="@style/IconBtn"
                        android:contentDescription="Menu"
                        android:src="@drawable/ic_more" />

                    <ImageButton
                        android:id="@+id/btnTabsDone"
                        style="@style/IconBtn"
                        android:contentDescription="Done"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/tabsBody"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:id="@+id/btnNewTab"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:drawableStart="@drawable/ic_plus"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:paddingStart="22dp"
                        android:paddingEnd="26dp"
                        android:text="New tab"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:alpha="0"
            android:elevation="12dp"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
