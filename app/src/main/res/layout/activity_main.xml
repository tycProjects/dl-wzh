<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0E0C27">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="20dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="هـ  H A M S" android:textColor="#BDB4FF" android:textSize="10sp" android:letterSpacing="0.18" android:textStyle="bold"/>
                <TextView android:id="@+id/screenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="المحادثات" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="3dp"/>
                <TextView android:id="@+id/screenSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="مساحتك الهادئة للتواصل ✦" android:textColor="#B9BEDC" android:textSize="12sp" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <TextView android:id="@+id/avatar" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="هـ" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"
                android:background="@drawable/bg_accent"/>
        </LinearLayout>
        <EditText android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="⌕   ابحث عن محادثة أو رسالة" android:singleLine="true" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:textColor="#FFFFFF" android:textColorHint="#AEB4D8" android:background="@drawable/bg_glass"
            android:inputType="text" android:imeOptions="actionSearch" android:textSize="14sp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp">
            <ScrollView android:id="@+id/contentScroll" android:layout_width="match_parent" android:layout_height="match_parent"
                android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
                <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingBottom="18dp"/>
            </ScrollView>
        </FrameLayout>
        <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="68dp"
            android:orientation="horizontal" android:gravity="center" android:padding="6dp"
            android:background="@drawable/bg_glass" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/tabChats" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:text="◉\nالمحادثات" android:textColor="#FFFFFF" android:textSize="11sp" android:lineSpacingExtra="3dp"/>
            <TextView android:id="@+id/tabStories" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:text="◌\nالحالات" android:textColor="#BFC4E9" android:textSize="11sp" android:lineSpacingExtra="3dp"/>
            <TextView android:id="@+id/tabCalls" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:text="⌕\nالمكالمات" android:textColor="#BFC4E9" android:textSize="11sp" android:lineSpacingExtra="3dp"/>
            <TextView android:id="@+id/tabSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:text="⚙\nالإعدادات" android:textColor="#BFC4E9" android:textSize="11sp" android:lineSpacingExtra="3dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
