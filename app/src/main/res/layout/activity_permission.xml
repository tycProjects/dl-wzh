<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zew_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/perm_header_card"
                style="@style/ZewMod.Card.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_zewmod_logo"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CẤP QUYỀN"
                        android:textColor="@color/zew_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/perm_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cấp đủ 3 quyền để mở khóa"
                        android:textSize="13sp"
                        android:textColor="@color/zew_yellow"
                        android:layout_marginTop="6dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/perm_steps_card"
                style="@style/ZewMod.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    
                    <LinearLayout
                        android:id="@+id/row_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_perm_row"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_overlay"
                            android:padding="4dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hiển thị trên ứng dụng khác"
                                android:textColor="@color/zew_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_overlay_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHƯA CẤP"
                                android:textSize="12sp"
                                android:textColor="@color/zew_red" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_grant_overlay"
                            style="@style/ZewMod.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="CẤP"
                            android:textSize="11sp" />
                    </LinearLayout>

                    
                    <LinearLayout
                        android:id="@+id/row_vpn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_perm_row"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_vpn"
                            android:padding="4dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kết nối VPN"
                                android:textColor="@color/zew_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_vpn_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHƯA CẤP"
                                android:textSize="12sp"
                                android:textColor="@color/zew_red" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_grant_vpn"
                            style="@style/ZewMod.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="CẤP"
                            android:textSize="11sp" />
                    </LinearLayout>

                    
                    <LinearLayout
                        android:id="@+id/row_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_perm_row">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_battery"
                            android:padding="4dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tắt tối ưu pin"
                                android:textColor="@color/zew_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_battery_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHƯA TẮT"
                                android:textSize="12sp"
                                android:textColor="@color/zew_red" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_grant_battery"
                            style="@style/ZewMod.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="TẮT"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_app"
                style="@style/ZewMod.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="MỞ ỨNG DỤNG"
                android:textSize="16sp"
                android:letterSpacing="0.1"
                android:enabled="false"
                android:alpha="0.4" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
