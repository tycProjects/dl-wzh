<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/setRoot" android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="?attr/colorSurface" android:fillViewport="true" android:clipToPadding="false">
  <LinearLayout android:id="@+id/setContent" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="24dp" android:paddingBottom="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="@string/settings_title" android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
      android:textColor="?attr/colorOnSurface"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
      android:text="@string/settings_sub" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
      android:textColor="?attr/colorOnSurfaceVariant"/>

    <FrameLayout android:id="@+id/phoneHost" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="20dp" android:background="@drawable/bg_stage" android:padding="16dp"/>

    <TextView style="@style/TextAppearance.Material3.TitleSmall" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/set_pos"
      android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/posGroup"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
      app:singleSelection="true" app:selectionRequired="true">
      <com.google.android.material.button.MaterialButton android:id="@+id/posLeft" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/pos_left"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/posCenter" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/pos_center"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/posRight" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/pos_right"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView style="@style/TextAppearance.Material3.TitleSmall" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/set_top"
      android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.slider.Slider android:id="@+id/posY"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:valueFrom="0" android:valueTo="160" android:stepSize="4" android:value="8"/>

    <TextView style="@style/TextAppearance.Material3.TitleSmall" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/set_size"
      android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/sizeGroup"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
      app:singleSelection="true" app:selectionRequired="true">
      <com.google.android.material.button.MaterialButton android:id="@+id/sizeS" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/size_s"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/sizeM" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/size_m"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/sizeL" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/size_l"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView style="@style/TextAppearance.Material3.TitleSmall" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/set_width"
      android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/widthGroup"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
      app:singleSelection="true" app:selectionRequired="true">
      <com.google.android.material.button.MaterialButton android:id="@+id/widthN" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/width_n"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/widthM" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/width_m"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/widthW" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/width_w"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView style="@style/TextAppearance.Material3.TitleSmall" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/set_show"
      android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swMsg"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_msg" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swCharge"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_charge" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swTimer"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_timer" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swMusic"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_music" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swVibe"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_vibe" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swGlass"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_glass" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swMulti"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_multi" android:textColor="?attr/colorOnSurface"/>

    <TextView style="@style/TextAppearance.Material3.TitleSmall" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/set_hide"
      android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/hideGroup"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
      app:singleSelection="true" app:selectionRequired="true">
      <com.google.android.material.button.MaterialButton android:id="@+id/hide2" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/hide_2"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/hide4" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/hide_4"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/hide8" android:layout_width="0dp"
        android:layout_height="44dp" android:layout_weight="1" android:text="@string/hide_8"
        style="@style/Widget.Material3.Button.OutlinedButton" android:insetTop="0dp" android:insetBottom="0dp"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swTime"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_time" android:textColor="?attr/colorOnSurface"/>

    <TextView style="@style/TextAppearance.Material3.TitleSmall" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/alpha_title"
      android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.slider.Slider android:id="@+id/alphaSlider"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:valueFrom="50" android:valueTo="100" android:stepSize="5" android:value="85"/>

    <com.google.android.material.button.MaterialButton android:id="@+id/checkMulti"
      style="@style/Widget.Material3.Button.TonalButton"
      android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp"
      android:text="@string/check_multi"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/openHistory"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp"
      android:text="@string/open_history"/>

    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swAuto"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_auto" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swApp"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_app" android:textColor="?attr/colorOnSurface"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/usageAccess"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"
      android:text="@string/usage_access"/>

    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swSound"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
      android:text="@string/sw_sound" android:textColor="?attr/colorOnSurface"/>

    <com.google.android.material.button.MaterialButton android:id="@+id/testBtn"
      android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="28dp"
      android:text="@string/set_test"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/resetBtn"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"
      android:text="@string/set_reset"/>
  </LinearLayout>
</ScrollView>
