<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_game"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:fontFamily="@font/orbitron"
            android:letterSpacing="0.3"
            android:layout_marginBottom="10dp"/>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_card_ff"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/ff_title"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/orbitron"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card_red"
                android:alpha="0.45"/>

            <Button
                android:id="@+id/btn_card_ffmax"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/ff_max_title"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/orbitron"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card_blue"
                android:alpha="0.45"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/card_border" android:layout_marginVertical="18dp"/>

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/features_label"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:fontFamily="@font/orbitron"
            android:letterSpacing="0.3"
            android:layout_marginBottom="10dp"/>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feature_card"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:text="@string/teleport"
                    android:textColor="@color/accent_red"
                    android:fontFamily="@font/orbitron"
                    android:textSize="13sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/teleport_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" android:layout_marginTop="3dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <Switch android:id="@+id/sw_teleport"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:thumbTint="@color/accent_red" android:trackTint="@color/switch_off"/>
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feature_card"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:text="@string/freeze"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="@font/orbitron"
                    android:textSize="13sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/freeze_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" android:layout_marginTop="3dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <Switch android:id="@+id/sw_freeze"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:thumbTint="@color/accent_cyan" android:trackTint="@color/switch_off"/>
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feature_card"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:text="@string/ghost"
                    android:textColor="@color/accent_purple"
                    android:fontFamily="@font/orbitron"
                    android:textSize="13sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/ghost_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" android:layout_marginTop="3dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <Switch android:id="@+id/sw_ghost"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:thumbTint="@color/accent_purple" android:trackTint="@color/switch_off"/>
        </LinearLayout>

        
        <TextView
            android:id="@+id/tv_customize_float"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/float_customize"
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            android:fontFamily="@font/orbitron"
            android:background="@drawable/bg_feature_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"/>

        
        <Button
            android:id="@+id/btn_inject"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/inject"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/orbitron"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.3"
            android:background="@drawable/bg_inject_btn"/>

    </LinearLayout>
</ScrollView>
