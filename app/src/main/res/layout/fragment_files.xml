<?xml version="1.0" encoding="utf-8"?>

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/files_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="32dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_files_hero_v2"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="6dp">

                
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_file_type_badge"
                    android:backgroundTint="#30FFFFFF">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_doc_text"
                        app:tint="#FFFFFF"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FILES"
                        android:textColor="#E6FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.32"
                        android:alpha="0.9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Quản lý file văn bản"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/heroSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Chọn · Tạo · Xem · Chỉnh sửa"
                        android:textColor="#D9F0FD"
                        android:textSize="11.5sp"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                
                <TextView
                    android:id="@+id/fileCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="30dp"
                    android:gravity="center"
                    android:background="@drawable/bg_file_type_badge"
                    android:backgroundTint="#40FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChooseFile"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/file_choose"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_action_btn_primary_v2"
                    app:icon="@drawable/ic_file_filled"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="16dp"
                    app:rippleColor="#30FFFFFF"
                    android:elevation="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewFile"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/file_new"
                    android:textColor="#A78BFA"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_action_btn_outlined_v2"
                    app:icon="@drawable/ic_plus"
                    app:iconTint="#A78BFA"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="16dp"
                    app:rippleColor="#308B5CF6" />
            </LinearLayout>

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="3dp">

                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/fileIconBadge"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_file_type_badge"
                        android:backgroundTint="#1A8B5CF6">

                        <ImageView
                            android:id="@+id/fileIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_doc_text"
                            app:tint="@color/brand_violet"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvFileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/file_none"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:ellipsize="middle"
                                android:maxWidth="180dp" />

                            <TextView
                                android:id="@+id/fileTypeChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_type_chip"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="TXT"
                                android:textColor="#A78BFA"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:id="@+id/fileStatusDot"
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_status_ok"
                                android:backgroundTint="#F59E0B" />

                            <TextView
                                android:id="@+id/tvFileMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnEdit"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_action_btn_outlined_v2"
                        android:src="@drawable/ic_edit"
                        android:scaleType="center"
                        android:enabled="false"
                        android:alpha="0.4"
                        android:contentDescription="Chỉnh sửa"
                        app:tint="@color/brand_violet" />
                </LinearLayout>

                
                <TextView
                    android:id="@+id/previewSnippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_preview_snippet"
                    android:padding="10dp"
                    android:text="Chưa có nội dung"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:visibility="gone" />

                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card_v2"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="3dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_stat_accent"
                            android:backgroundTint="@color/brand_violet" />

                        <TextView
                            android:id="@+id/statLines"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/brand_violet"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/file_stats_lines"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card_v2"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="3dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_stat_accent"
                            android:backgroundTint="@color/brand_pink" />

                        <TextView
                            android:id="@+id/statWords"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/brand_pink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/file_stats_words"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card_v2"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="3dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_stat_accent"
                            android:backgroundTint="@color/brand_cyan" />

                        <TextView
                            android:id="@+id/statChars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/brand_cyan"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/file_stats_chars"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            
            <LinearLayout
                android:id="@+id/loadingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/loadingSpinner"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/loading_spinner"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loadingTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang đọc file…"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/loadingSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Vui lòng đợi"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCancelLoading"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_action_btn_outlined_v2"
                        android:src="@drawable/ic_close"
                        android:scaleType="center"
                        android:contentDescription="Huỷ"
                        app:tint="@color/danger" />
                </LinearLayout>

                <View
                    android:id="@+id/skeleton1"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:id="@+id/skeleton2"
                    android:layout_width="180dp"
                    android:layout_height="9dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/skeleton_block" />

                <ProgressBar
                    android:id="@+id/loadingProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/brand_violet"
                    android:progressBackgroundTint="@color/glass_input_border"
                    android:indeterminate="true" />
            </LinearLayout>

            
            <LinearLayout
                android:id="@+id/recentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                android:elevation="3dp">

                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_file_type_badge"
                        android:backgroundTint="#1A06B6D4">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file"
                            app:tint="@color/brand_cyan"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="File gần đây"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClearRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@android:color/transparent"
                        android:text="Xoá tất cả"
                        android:textAllCaps="false"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_search_v2">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ic_search"
                        android:importantForAccessibility="no"
                        app:tint="@color/text_muted" />

                    <EditText
                        android:id="@+id/searchRecent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="38dp"
                        android:layout_marginEnd="38dp"
                        android:background="@android:color/transparent"
                        android:hint="Lọc theo tên file…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_dim"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnClearSearch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="6dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_close"
                        android:scaleType="center"
                        android:visibility="gone"
                        android:contentDescription="Xoá tìm kiếm"
                        app:tint="@color/text_muted" />
                </FrameLayout>

                
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/filterChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="6dp"
                        app:checkedChip="@id/chipAll" >

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tất cả"
                            android:textSize="12sp"
                            android:checked="true"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="12dp"
                            app:textStartPadding="12dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTxt"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TXT"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="12dp"
                            app:textStartPadding="12dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMd"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MD"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="12dp"
                            app:textStartPadding="12dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCsv"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CSV"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="12dp"
                            app:textStartPadding="12dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipJson"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JSON"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="12dp"
                            app:textStartPadding="12dp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/sortChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="6dp"
                        app:checkedChip="@id/chipSortRecent">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSortRecent"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mới nhất"
                            android:textSize="11sp"
                            android:checked="true"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="10dp"
                            app:textStartPadding="10dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSortName"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A → Z"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="10dp"
                            app:textStartPadding="10dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSortSize"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dung lượng"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@drawable/bg_filter_chip_v2"
                            app:chipStrokeWidth="0dp"
                            app:chipMinTouchTargetSize="0dp"
                            app:textEndPadding="10dp"
                            app:textStartPadding="10dp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:clipToPadding="false" />
            </LinearLayout>

            
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_empty_state_v2"
                android:visibility="gone"
                android:elevation="2dp">

                <ImageView
                    android:tag="empty_illu"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_empty_files"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Chưa có file nào"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chọn file .txt hoặc tạo file mới để bắt đầu"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyPick"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="Chọn file .txt"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_action_btn_primary_v2"
                    app:icon="@drawable/ic_file_filled"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:strokeWidth="0dp"
                    app:cornerRadius="16dp"
                    app:rippleColor="#30FFFFFF"
                    android:elevation="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
