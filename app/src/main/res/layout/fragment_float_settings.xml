<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/float_title"
        android:textColor="@color/accent_red"
        android:fontFamily="@font/orbitron"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:layout_marginBottom="20dp"/>

    
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_feature_card"
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:text="@string/float_size"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/orbitron"
                android:textSize="11sp"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView android:id="@+id/tv_size_value"
                android:textColor="@color/accent_red"
                android:fontFamily="@font/orbitron"
                android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seek_size"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="120" android:min="40" android:progress="60"
            android:progressTint="@color/accent_red"
            android:thumbTint="@color/accent_red"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_feature_card"
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:text="@string/float_opacity"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/orbitron"
                android:textSize="11sp"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView android:id="@+id/tv_opacity_value"
                android:textColor="@color/accent_red"
                android:fontFamily="@font/orbitron"
                android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seek_opacity"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="100" android:min="20" android:progress="85"
            android:progressTint="@color/accent_red"
            android:thumbTint="@color/accent_red"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/float_hint"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"/>

</LinearLayout>
