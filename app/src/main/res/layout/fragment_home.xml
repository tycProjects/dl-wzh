<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zew_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_header_card"
            style="@style/ZewMod.Card.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_dot"
                        android:backgroundTint="@color/zew_yellow" />

                    <TextView
                        android:id="@+id/tv_engine_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CHƯA SẴN SÀNG"
                        android:textColor="@color/zew_yellow"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZEWMOD"
                        android:textColor="@color/zew_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_launch_main"
                    style="@style/ZewMod.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="KHỞI CHẠY"
                    android:textSize="16sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="14dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_game_card"
            style="@style/ZewMod.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHỌN GAME"
                    android:textColor="@color/zew_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_game_prev"
                        style="@style/ZewMod.Button.IconNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="‹"
                        android:textSize="20sp"
                        app:iconPadding="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/iv_game_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_ff"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tv_selected_game"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Free Fire"
                                android:textColor="@color/zew_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_game_install"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ĐÃ CÀI"
                                android:textSize="11sp"
                                android:textColor="@color/zew_green" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_game_next"
                        style="@style/ZewMod.Button.IconNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="›"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/game_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/3"
                    android:textColor="@color/zew_text_dim"
                    android:textSize="11sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_mode_card"
            style="@style/ZewMod.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHẾ ĐỘ"
                    android:textColor="@color/zew_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_prev"
                        style="@style/ZewMod.Button.IconNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="‹"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_selected_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CHỌN SẴN"
                        android:textColor="@color/zew_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:gravity="center" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_next"
                        style="@style/ZewMod.Button.IconNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="›"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mode_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/4"
                    android:textColor="@color/zew_text_dim"
                    android:textSize="11sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_launch_card"
            style="@style/ZewMod.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KIỂU KHỞI CHẠY"
                    android:textColor="@color/zew_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_launch_mode_prev"
                        style="@style/ZewMod.Button.IconNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="‹"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_selected_launch_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CARD"
                        android:textColor="@color/zew_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_launch_mode_next"
                        style="@style/ZewMod.Button.IconNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="›"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
