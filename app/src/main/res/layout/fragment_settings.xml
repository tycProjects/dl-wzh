<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feature_card"
            android:padding="20dp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">
            <TextView android:text="KILLCHEAT"
                android:textColor="@color/accent_red"
                android:fontFamily="@font/orbitron"
                android:textSize="22sp" android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Free Fire Game Utility"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" android:layout_marginTop="4dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <View android:layout_width="36dp" android:layout_height="1dp"
                android:background="@color/accent_red"
                android:layout_marginVertical="12dp"/>
            <TextView android:text="@string/version_label"
                android:textColor="@color/accent_red"
                android:fontFamily="@font/orbitron"
                android:textSize="10sp" android:letterSpacing="0.2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feature_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">
            <TextView android:text="@string/settings_about_title"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/orbitron"
                android:textSize="9sp" android:letterSpacing="0.3"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="@string/settings_about_body"
                android:textColor="@color/text_primary"
                android:textSize="12sp" android:lineSpacingMultiplier="1.5"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feature_card"
            android:padding="16dp"
            android:orientation="vertical">
            <TextView android:text="@string/settings_admin"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/orbitron"
                android:textSize="9sp" android:letterSpacing="0.3"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="@string/admin_name"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/orbitron"
                android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="@string/admin_contact"
                android:textColor="@color/accent_red"
                android:textSize="12sp" android:layout_marginTop="4dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="@string/copyright"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" android:layout_marginTop="12dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
