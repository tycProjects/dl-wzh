<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerToggles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnAplicar"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/btnAplicar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="10dp"
        android:background="@drawable/bg_pill_accent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtAplicarTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APLICAR MUDANÇAS"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAplicarSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque pra aplicar tudo de uma vez"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</RelativeLayout>
