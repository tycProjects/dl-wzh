<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingStart="13dp" android:paddingEnd="13dp" android:paddingTop="13dp" android:paddingBottom="13dp"
    android:layout_marginBottom="9dp" android:background="@drawable/bg_glass">
    <TextView android:id="@+id/chatAvatar" android:layout_width="48dp" android:layout_height="48dp"
        android:gravity="center" android:text="س" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
        android:background="@drawable/bg_accent"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/chatName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="سارة" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
        <TextView android:id="@+id/chatPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="أهلًا، كيف حالك؟" android:textColor="#BFC4E9" android:textSize="12sp" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/chatTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الآن" android:textColor="#BFC4E9" android:textSize="10sp"/>
        <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginTop="7dp" android:background="@drawable/bg_dot"/>
    </LinearLayout>
</LinearLayout>
