<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
 <TextView android:id="@+id/name" android:textColor="@color/text" android:textStyle="bold" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/meta" android:textColor="@color/muted" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/play" android:text="PLAY" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"/>
  <Button android:id="@+id/share" android:text="SHARE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"/>
  <Button android:id="@+id/delete" android:text="DELETE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"/>
 </LinearLayout>
</LinearLayout>
