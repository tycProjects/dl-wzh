<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/window_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_window"
    android:padding="12dp"
    android:elevation="16dp">

    
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_window_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✨ Zonex Emoji"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_lang_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_tab_inactive"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_minimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="—"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="#1E293B"
        android:padding="2dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tab_encode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔒 এনকোড"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_active"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_decode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔓 ডিকোড"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:background="@drawable/bg_tab_inactive"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        
        <LinearLayout
            android:id="@+id/layout_encode_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_label_encode_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="গোপন বার্তা লিখুন"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_input_encode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:maxHeight="90dp"
                android:gravity="top|start"
                android:hint="এখানে গোপন বার্তা লিখুন..."
                android:textColorHint="#64748B"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:background="@drawable/bg_glass_input"
                android:padding="8dp"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_byte_counter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="০ B"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_paste_encode"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="📋 পেস্ট"
                    android:textSize="11sp"
                    android:textColor="#F8FAFC"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/bg_pill_btn"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_clear_encode"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="🗑️ মুছুন"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/bg_tab_inactive" />
            </LinearLayout>

            
            <TextView
                android:id="@+id/tv_label_carrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাহক ইমোজি (একক ইমোজি দৃশ্যমান থাকবে)"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btn_quick_emoji_1"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="🤔"
                    android:textSize="18sp"
                    android:background="@drawable/bg_pill_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btn_quick_emoji_2"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="😎"
                    android:textSize="18sp"
                    android:background="@drawable/bg_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btn_quick_emoji_3"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="❤️"
                    android:textSize="18sp"
                    android:background="@drawable/bg_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btn_quick_emoji_4"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="🔥"
                    android:textSize="18sp"
                    android:background="@drawable/bg_tab_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <EditText
                    android:id="@+id/et_carrier_emoji"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:hint="নিজের ইমোজি দিন..."
                    android:textColorHint="#64748B"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/bg_glass_input"
                    android:singleLine="true" />
            </LinearLayout>

            
            <Button
                android:id="@+id/btn_execute_encode"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="🔒 একক ইমোজিতে এনকোড করুন"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_accent_btn"
                android:layout_marginBottom="6dp" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_input"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_encode_result_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ফলাফল (একক ইমোজি):"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_copy_encode"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="📋 কপি"
                        android:textSize="10sp"
                        android:textColor="#38BDF8"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:background="@drawable/bg_pill_btn"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_share_encode"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="↗ শেয়ার"
                        android:textSize="10sp"
                        android:textColor="#A855F7"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:background="@drawable/bg_pill_btn" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_result_encode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🤔"
                    android:textColor="#38BDF8"
                    android:textSize="28sp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/layout_decode_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_decode_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="এনকোড করা ইমোজি পেস্ট করুন"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_input_decode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:maxHeight="90dp"
                android:gravity="top|start"
                android:hint="ইমোজি এখানে পেস্ট করুন..."
                android:textColorHint="#64748B"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:background="@drawable/bg_glass_input"
                android:padding="8dp"
                android:inputType="textMultiLine" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_decode_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_paste_decode"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="📋 পেস্ট"
                    android:textSize="11sp"
                    android:textColor="#F8FAFC"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/bg_pill_btn"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_clear_decode"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="🗑️ মুছুন"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:background="@drawable/bg_tab_inactive" />
            </LinearLayout>

            
            <Button
                android:id="@+id/btn_execute_decode"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="🔓 গোপন বার্তা ডিকোড করুন"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_accent_btn"
                android:layout_marginBottom="8dp" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_input"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_decode_result_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="উদ্ধারকৃত আসল বার্তা:"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_copy_decode"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="📋 কপি বার্তা"
                        android:textSize="10sp"
                        android:textColor="#10B981"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:background="@drawable/bg_pill_btn" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_result_decode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:maxHeight="90dp"
                    android:scrollbars="vertical"
                    android:text="ডিকোড করা বার্তা এখানে দৃশ্যমান হবে..."
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
