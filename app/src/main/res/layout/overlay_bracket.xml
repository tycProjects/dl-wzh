<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F0050509"
    android:elevation="16dp">

    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="#FF3D7F">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Game Bracket"
            android:textColor="#FFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMin"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="—"
            android:textColor="#FFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFF"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOverlayInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="Bracket aktif\nBuka app utama untuk atur match"
        android:textColor="#F3F3F7"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:id="@+id/tvOverlayChamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Juara: —"
        android:textColor="#1AD9C8"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="#0C0C14" />
</LinearLayout>
