							<it.beppi.tristatetogglebutton_library.TriStateToggleButton
								android:id="@+id/switch4"
								android:layout_width="55dp"
								android:layout_height="25dp"
								android:gravity="right|center_vertical"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#FFFFFF"
								app:tbIsMidSelectable="false"
								app:tbDefaultStatus="off"
								app:tbOffColor="#FF424242"
								app:tbOffBorderColor="#FF424242"
								app:tbOnColor="#FF424242"
								app:tbSpotColor="#FF0000"
								app:tbSwipeSensitivityPixels="200"
								app:tbAnimate="true"
								app:tbBorderWidth="1dp"
								 />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear19"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="20dp"
						android:padding="15dp"
						android:background="#121416"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/linear20"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">
							<LinearLayout
								android:id="@+id/line2"
								android:layout_width="6dp"
								android:layout_height="25dp"
								android:padding="8dp"
								android:background="#FF0000"
								android:orientation="vertical" />
							<TextView
								android:id="@+id/textview13"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="BYPASS"
								android:textSize="12sp"
								android:textStyle="bold"
								android:textColor="#616161" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear29"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical">
							<TextView
								android:id="@+id/textview14"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="𝗝𝗢𝗜𝗡 𝗧𝗘𝗟𝗘𝗚𝗥𝗔𝗠 𝗙𝗢𝗥 𝗠𝗢𝗥𝗘 𝗨𝗣𝗗𝗔𝗧𝗘𝗦 📲🔥"
								android:textSize="12sp"
								android:textColor="#757575" />
