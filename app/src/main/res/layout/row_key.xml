<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_row" android:paddingHorizontal="10dp" android:paddingVertical="8dp">
    <TextView android:id="@+id/rowName" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="@color/text" android:textSize="13sp"/>
    <TextView android:id="@+id/rowKey" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_chip" android:paddingHorizontal="10dp" android:paddingVertical="4dp"
        android:textColor="@color/cyan" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
