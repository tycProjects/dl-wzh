<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layoutDirection="rtl">
    <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDEDED" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/n_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5486B" android:textSize="13sp" android:paddingTop="2dp" />
    <TextView android:id="@+id/n_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8E8E96" android:textSize="12sp" />
</LinearLayout>
