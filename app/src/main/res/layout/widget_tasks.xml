<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:layoutDirection="rtl">
    <TextView android:id="@+id/t_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5486B" android:textSize="15sp" android:textStyle="bold" android:paddingBottom="6dp" />
    <TextView android:id="@+id/t_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8E8E96" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/t_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDEDED" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="2dp" />
    <TextView android:id="@+id/t_l2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDEDED" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="2dp" />
    <TextView android:id="@+id/t_l3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDEDED" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="2dp" />
    <TextView android:id="@+id/t_l4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDEDED" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="2dp" />
    <TextView android:id="@+id/t_l5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDEDED" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="2dp" />
</LinearLayout>
