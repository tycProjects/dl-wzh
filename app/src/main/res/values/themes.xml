<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#087F74</item>
        <item name="colorPrimaryDark">#075E56</item>
        <item name="colorAccent">#0F9688</item>
        <item name="android:statusBarColor">#075E56</item>
        <item name="android:navigationBarColor">#F3F6FA</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F3F6FA</item>
        <item name="buttonStyle">@style/SensiButton</item>
    </style>
    <style name="SensiButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">#E0E8EE</item>
        <item name="android:textColor">#17212F</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
</resources>
