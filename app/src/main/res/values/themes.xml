<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LiveVideoWallpaper" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_50</item>
        <item name="colorOnPrimaryContainer">@color/blue_900</item>
        <item name="android:statusBarColor">@color/blue_700</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.LiveVideoWallpaper.Call" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
