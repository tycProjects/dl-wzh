<resources>
    <color name="bg">#0A0B10</color>
    <color name="card">#12141C</color>
    <color name="surface2">#1A1D28</color>
    <color name="stroke">#23273A</color>
    <color name="text">#E8EAF2</color>
    <color name="text_dim">#8B90A5</color>
    <color name="neon_blue">#00E5FF</color>
    <color name="neon_purple">#7C4DFF</color>
    <color name="neon_red">#FF4D6A</color>
    <color name="ok">#2EE6A6</color>
    <style name="Theme.Supra" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorPrimary">@color/neon_blue</item>
        <item name="colorSecondary">@color/neon_purple</item>
    </style>
    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>
    <style name="Help">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="Sw">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
