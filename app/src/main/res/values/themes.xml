<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Meloza" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    
    <style name="Theme.Meloza.Starting" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.Meloza</item>
        <item name="windowSplashScreenBackground">#FF0E0B16</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
