# Generate a unique random secret of at least 32 characters. Never commit real values.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=8080
DB_PATH=./sensiscreen.sqlite

# Optional: set BOTH only to create the first Admin at server startup.
# Use a unique password of at least 12 characters. Remove both values after creation.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
