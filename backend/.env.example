# Скопируйте в .env и заполните. Файл .env не коммитится.
PORT=8080
DATA_DIR=./data
# Вход через Telegram (бот создаётся в @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=droid_storebot
TELEGRAM_WEBHOOK_SECRET=
# Публичный https-адрес сервера для webhook (например, через cloudflared/ngrok для теста)
PUBLIC_URL=
# Числовой Telegram ID владельца (узнать у @userinfobot). Получает роль owner при первом входе.
OWNER_TELEGRAM_ID=8358748598
# Необязательно: проверка APK через VirusTotal
VIRUSTOTAL_API_KEY=
# Только для локальной разработки. В продакшене 0.
DEV_AUTH=0
