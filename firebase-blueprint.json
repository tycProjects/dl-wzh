{
  "entities": {
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration and remote controls set by Admin",
      "type": "object",
      "properties": {
        "maintenance_mode": { "type": "boolean", "description": "Whether maintenance mode is currently active" },
        "maintenance_title": { "type": "string", "description": "Title shown during maintenance" },
        "maintenance_message": { "type": "string", "description": "Bengali/English maintenance message" },
        "maintenance_image_url": { "type": "string", "description": "Optional illustration URL for maintenance" },
        "min_version": { "type": "string", "description": "Minimum required app version" },
        "latest_version": { "type": "string", "description": "Latest published app version" },
        "force_update": { "type": "boolean", "description": "Enforce mandatory update popup" },
        "update_title": { "type": "string", "description": "Update popup header" },
        "update_description": { "type": "string", "description": "Release notes and update details" },
        "update_url": { "type": "string", "description": "Download link for new APK" },
        "telegram_popup_enabled": { "type": "boolean", "description": "Whether to display the Telegram join popup" },
        "telegram_message": { "type": "string", "description": "Telegram prompt text" },
        "telegram_url": { "type": "string", "description": "Telegram channel invite link" },
        "telegram_image_url": { "type": "string", "description": "Banner image for Telegram dialog" },
        "telegram_join_label": { "type": "string", "description": "Button label for join" },
        "telegram_later_label": { "type": "string", "description": "Button label for later" },
        "user_uploads_enabled": { "type": "boolean", "description": "Allows users to upload custom sounds in My Sounds" },
        "upload_size_limit_mb": { "type": "number", "description": "Max upload size limit in MB" },
        "ad_banner_enabled": { "type": "boolean", "description": "Enable banner ads" },
        "ad_interstitial_enabled": { "type": "boolean", "description": "Enable interstitial ads" },
        "ad_rewarded_enabled": { "type": "boolean", "description": "Enable rewarded ads before download" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Dynamic soundboard category created and managed by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category identifier" },
        "name": { "type": "string", "description": "Category title" },
        "icon": { "type": "string", "description": "Icon key or identifier" },
        "order": { "type": "number", "description": "Display order index" },
        "is_hidden": { "type": "boolean", "description": "Whether the category is hidden" },
        "created_at": { "type": "number", "description": "Timestamp when category was created" }
      },
      "required": ["name", "order"]
    },
    "Sound": {
      "title": "Sound",
      "description": "A gaming sound effect in the global sound library published by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique sound ID" },
        "title": { "type": "string", "description": "Sound name" },
        "category_id": { "type": "string", "description": "ID of parent category" },
        "category_name": { "type": "string", "description": "Name of parent category" },
        "audio_url": { "type": "string", "description": "Direct audio URL or bundle stream" },
        "duration_seconds": { "type": "number", "description": "Duration of audio track" },
        "thumbnail_url": { "type": "string", "description": "Thumbnail artwork URL" },
        "is_published": { "type": "boolean", "description": "Whether sound is public" },
        "download_count": { "type": "number", "description": "Count of user downloads" },
        "play_count": { "type": "number", "description": "Count of sound plays" },
        "requires_rewarded_ad": { "type": "boolean", "description": "Prompt rewarded ad on download" },
        "created_at": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["title", "audio_url"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with preferences and favorite sound IDs",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user ID" },
        "email": { "type": "string", "description": "User email address" },
        "display_name": { "type": "string", "description": "Display name" },
        "photo_url": { "type": "string", "description": "Avatar image URL" },
        "favorites": { "type": "string", "description": "JSON array of favorite sound IDs" },
        "last_active": { "type": "number", "description": "Last active timestamp" }
      },
      "required": ["uid"]
    },
    "UserSound": {
      "title": "UserSound",
      "description": "Private sound uploaded or recorded by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique private sound ID" },
        "user_id": { "type": "string", "description": "Owner user UID" },
        "title": { "type": "string", "description": "User custom sound title" },
        "audio_url": { "type": "string", "description": "Local URI or secure data storage URL" },
        "duration_seconds": { "type": "number", "description": "Length of audio in seconds" },
        "created_at": { "type": "number", "description": "Upload timestamp" }
      },
      "required": ["user_id", "title", "audio_url"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "System broadcast announcement or update alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique notification ID" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Body copy" },
        "type": { "type": "string", "description": "Type: announcement, sound, update, maintenance" },
        "created_at": { "type": "number", "description": "Timestamp" }
      },
      "required": ["title", "message"]
    }
  },
  "firestore": {
    "/settings/{configId}": {
      "schema": "#/entities/AppConfig",
      "description": "Admin settings and maintenance toggles"
    },
    "/categories/{categoryId}": {
      "schema": "#/entities/Category",
      "description": "Dynamic sound categories"
    },
    "/sounds/{soundId}": {
      "schema": "#/entities/Sound",
      "description": "Global sound library published by Admin"
    },
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profiles and favorites"
    },
    "/users/{userId}/my_sounds/{soundId}": {
      "schema": "#/entities/UserSound",
      "description": "User's private sounds in My Sounds"
    },
    "/notifications/{notificationId}": {
      "schema": "#/entities/NotificationItem",
      "description": "Announcements and alerts"
    }
  }
}
